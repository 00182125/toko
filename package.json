{
  "name": "toko-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/check-layers.mjs && tsc --noEmit",
    "eval:chat": "esbuild scripts/chat-eval.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/chat-eval.mjs --log-level=error && node node_modules/.cache/chat-eval.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
